# Application Settings
APP_NAME=e-gov API FastAPI
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# Redis Settings
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0

# e-gov API Settings
EGOV_API_BASE_URL=https://laws.e-gov.go.jp
EGOV_API_TIMEOUT=30

# Database Settings (optional for Phase 2+)
DATABASE_URL=postgresql://egov:egov_password@postgres:5432/egov_db

# LLM Provider Settings (Multi-LLM Support)
DEFAULT_LLM_PROVIDER=anthropic  # Options: anthropic, deepseek, gemini

# Anthropic Claude API Settings
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-4-5
# Available models: claude-haiku-4-5, claude-3-5-sonnet-20241022, claude-3-opus-20240229
# See: https://docs.anthropic.com/en/docs/about-claude/models

# DeepSeek AI API Settings
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
# Available models: deepseek-chat, deepseek-coder
# See: https://platform.deepseek.com/api-docs/

# Google Gemini API Settings
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp
# Available models: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash
# See: https://ai.google.dev/gemini-api/docs/models
